  "implementation_rule": "The research boundary-case schema is not inherited automatically. This model is clause-derived and separates applicability from evidence sufficiency.",
  "publication_status": "unpublished",
  "source_version": "ASR_001_PROFILE_MODEL_V0.1.json",
  "refinement_basis": [
    "separate applicability from evidence state",
    "support autonomous agency-regime disclosure without live human performance",
    "make JSON distribution applicability structural",
    "make correction and supersession explicit",
    "avoid mandatory external evidence duplication for declarative and lifecycle clauses"
  ],
  "profile_lifecycle": {
