{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altissports.com/schemas/asr-001-review-comment-v0.1.schema.json",
  "title": "ASR-001 Operator Review Comment v0.1",
  "description": "Structured written review comment. Submission does not imply endorsement or adoption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comment_id",
    "working_draft_baseline",
    "reviewer",
    "target",
    "issue",
    "evidence",
    "proposed_disposition",
    "confirmations"
  ],
  "properties": {
    "comment_id": {
      "type": "string",
      "pattern": "^ORC-[0-9]{4}-[0-9]{3,}$"
    },
    "working_draft_baseline": {
      "const": "ASR-001 v0.2"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "reviewer_class",
        "attribution_preference",
        "conflict_declaration_id"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_class": {
          "enum": [
            "RC-01",
            "RC-02",
            "RC-03",
            "RC-04",
            "RC-05",
            "RC-06",
            "RC-07"
          ]
        },
        "organization_or_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution_preference": {
          "enum": [
            "named",
            "role_only",
            "anonymous",
            "internal_only"
          ]
        },
        "conflict_declaration_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "domain_id",
        "profile_field",
        "artifact",
        "question_id"
      ],
      "properties": {
        "clause_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ASR001-D(0[1-9]|1[0-5])-C[0-9]{2}$"
        },
        "domain_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^D(0[1-9]|1[0-5])$"
        },
        "profile_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_type",
        "severity",
        "observation",
        "operational_scenario",
        "failure_reason",
        "consequence"
      ],
      "properties": {
        "issue_type": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocking",
            "major",
            "minor",
            "editorial",
            "observation"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "operational_scenario": {
          "type": "string",
          "minLength": 1
        },
        "failure_reason": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "description",
        "public_reference",
        "confidentiality_limitation",
        "date_or_period"
      ],
      "properties": {
        "evidence_class": {
          "enum": [
            "operational_experience",
            "organizational_policy",
            "published_rule_or_standard",
            "empirical_research",
            "technical_specification",
            "reasoned_interpretation",
            "hypothetical_concern"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "public_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidentiality_limitation": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_or_period": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "proposed_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_disposition",
        "replacement_text_or_field",
        "applicability_impact",
        "verification_impact",
        "evidence_burden_impact",
        "scope_impact",
        "boundary_impact"
      ],
      "properties": {
        "preferred_disposition": {
          "enum": [
            "accept",
            "accept_with_revision",
            "reject_with_rationale",
            "defer_pending_evidence",
            "out_of_scope",
            "duplicate",
            "no_change"
          ]
        },
        "replacement_text_or_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "applicability_impact": {
          "type": "string"
        },
        "verification_impact": {
          "type": "string"
        },
        "evidence_burden_impact": {
          "type": "string"
        },
        "scope_impact": {
          "enum": [
            "none",
            "narrowing",
            "potential_expansion_requires_hold"
          ]
        },
        "boundary_impact": {
          "type": "string"
        }
      }
    },
    "confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_endorsement",
        "revision_permission",
        "anonymized_issue_permission"
      ],
      "properties": {
        "not_endorsement": {
          "const": true
        },
        "revision_permission": {
          "type": "boolean"
        },
        "anonymized_issue_permission": {
          "type": "boolean"
        },
        "additional_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
